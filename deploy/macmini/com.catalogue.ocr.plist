<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.catalogue.ocr</string>
  <key>WorkingDirectory</key>
  <string>__ROOT__/services/ocr</string>
  <key>ProgramArguments</key>
  <array>
    <string>__ROOT__/services/ocr/.venv/bin/python</string>
    <string>app.py</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__LOGS__/ocr.log</string>
  <key>StandardErrorPath</key>
  <string>__LOGS__/ocr.err.log</string>
</dict>
</plist>
