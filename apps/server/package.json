{
  "name": "@catalogue/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/main.ts",
    "init": "tsx --env-file-if-exists=../../.env src/cli/init.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@catalogue/shared": "*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@huggingface/transformers": "^4.3.1",
    "@node-rs/argon2": "^2.2.2",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.2.1",
    "pdfjs-dist": "^6.4.299",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^5.0.5"
  }
}
