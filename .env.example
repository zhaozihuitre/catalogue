# 复制为 .env 后按需修改。.env 已在 .gitignore 中，不会提交。

# 数据目录：加密数据库、加密档案文件、keystore.json（只含盐和 KDF 参数，不含密钥）
CATALOGUE_DATA_DIR=./data

# 监听地址与端口。生产环境填写主机的内网 IP，不要映射到公网
CATALOGUE_HOST=127.0.0.1
CATALOGUE_PORT=8443

# HTTPS 证书（生产环境必填，可用 deploy/gen-certs.sh 生成）
# CATALOGUE_TLS_CERT=./certs/server.crt
# CATALOGUE_TLS_KEY=./certs/server.key

# 可信家庭内网 / Tailscale：不配证书，直接以 HTTP 提供服务（电脑、手机、电视打开网址即可）。
# 同一网络内流量未加密；客户自有云服务器部署必须改用 HTTPS。
# CATALOGUE_ALLOW_HTTP=1

# 仅限本机开发：允许 HTTP 和简单密码，且强制只监听 127.0.0.1
CATALOGUE_DEV_INSECURE=1

# 本地 AI 服务（只允许本机或内网地址）
CATALOGUE_OLLAMA_URL=http://127.0.0.1:11434
CATALOGUE_LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
CATALOGUE_OCR_URL=http://127.0.0.1:8866
CATALOGUE_EMBED_MODEL=Xenova/bge-small-zh-v1.5
CATALOGUE_MODEL_DIR=./models

# 登录会话有效期（天）
CATALOGUE_SESSION_TTL_DAYS=14

# 不建议：启动时自动解锁。口令写在文件里会削弱"密钥由客户自持"的保护
# CATALOGUE_PASSPHRASE=
